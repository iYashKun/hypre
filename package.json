{
  "name": "@yashkun/hypre",
  "version": "0.3.2",
  "description": "a universal TypeScript based hot reload engine",
  "engines": {
    "node": ">=22.22.0"
  },
  "author": "Yash",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "hypre": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.9",
    "picomatch": "^4.0.7",
    "tree-kill": "^1.2.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
