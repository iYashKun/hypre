
{
  "name": "re",
  "version": "0.1.0",
  "description": "Universal TypeScript based hot reload engine",
  "main": "dist/index.js",
  "bin": { "hyperreload": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tree-kill": "^1.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
